S04_08_C  tb_mesh_c  -  -define TB_MESH_N=8 -define TB_NUM_VC=4 -define TB_B_MAX=15             -plus +TEST=S01 -plus +QUICK -plus +S01_CYCLES=30000
S04_09_C  tb_mesh_c  -  -define TB_NUM_VC=4 -define TB_B_MAX=15 -define TB_SAFE                 -plus +TEST=S01 -plus +QUICK -plus +S01_CYCLES=30000
S04_10_C  tb_mesh_c  -  -define TB_MESH_N=8 -define TB_NUM_VC=1 -define TB_B_MAX=5 -define TB_SAFE -plus +TEST=S01 -plus +QUICK -plus +S01_CYCLES=30000
S04_11_D  tb_mesh_d  -  -define TB_NUM_VC=1 -define TB_B_MAX=15                                 -plus +TEST=S01 -plus +QUICK -plus +S01_CYCLES=30000
S04_12_D  tb_mesh_d  -  -define TB_NUM_VC=2 -define TB_B_MAX=10 -define TB_SAFE                 -plus +TEST=S01 -plus +QUICK -plus +S01_CYCLES=30000
S04_13_D  tb_mesh_d  -  -define TB_MESH_N=8 -define TB_NUM_VC=4 -define TB_B_MAX=10 -define TB_SAFE -plus +TEST=S01 -plus +QUICK -plus +S01_CYCLES=30000
S04_14_D  tb_mesh_d  -  -define TB_NUM_VC=4 -define TB_B_MAX=5                                  -plus +TEST=S01 -plus +QUICK -plus +S01_CYCLES=30000
